---
import SiteLayout from './SiteLayout.astro';
interface Props { title: string; description: string; updated?: string; category?: string; toc?: { id: string; title: string }[] }
const { title, description, updated, category = 'Help & support', toc = [] } = Astro.props;
const updatedLabel = updated ? new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${updated}T12:00:00Z`)) : undefined;
---
<SiteLayout title={`${title} — AstroDyuti`} description={description}>
  <div class="container document-heading">
    <a class="back-link" href="/">← Back to AstroDyuti</a>
    <p class="eyebrow">{category}</p>
    <h1>{title}</h1>
    {updatedLabel && <p class="document-meta">Last updated <time datetime={updated}>{updatedLabel}</time></p>}
  </div>
  <div class:list={['container', 'document-grid', { 'has-toc': toc.length > 0 }]}>
    {toc.length > 0 && <aside class="document-sidebar"><details class="toc" open><summary>On this page</summary><nav aria-label="On this page"><ol>{toc.map((heading) => <li><a href={`#${heading.id}`}>{heading.title}</a></li>)}</ol></nav></details></aside>}
    <article class="prose"><slot /></article>
  </div>
</SiteLayout>
