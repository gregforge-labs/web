---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
interface Props { title: string; description?: string; canonical?: string; noindex?: boolean; home?: boolean }
const { title, description = site.description, canonical = Astro.url.pathname, noindex = false, home = false } = Astro.props;
const canonicalUrl = new URL(canonical, site.url).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site.url}/#organization`, name: site.company, url: `${site.url}/`, logo: `${site.url}/assets/app-icon.png`, email: site.email },
    ...(home ? [{ '@type': 'MobileApplication', '@id': `${site.url}/#app`, name: site.name, description, applicationCategory: 'LifestyleApplication', operatingSystem: ['iOS', 'Android'], url: `${site.url}/`, downloadUrl: [site.stores.ios, site.stores.android], image: `${site.url}/assets/astrodyuti-social-card.png`, publisher: { '@id': `${site.url}/#organization` }, inLanguage: ['en', 'hi', 'te', 'ta', 'kn', 'ml', 'bn', 'mr', 'gu'] }] : []),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f5ee" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${site.url}/assets/astrodyuti-social-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AstroDyuti — your Vedic birth chart, made clear" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/assets/astrodyuti-social-card.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <slot name="head" />
  </head>
  <body class:list={[home && 'home-page']}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
