---
import Icon from '../Icon.astro';
const panels = [
  { id: 'chart', label: 'Birth chart', eyebrow: 'Understand your kundli', title: 'Your story goes beyond a sun sign.', description: 'Your kundli maps the sky for your birth time and place. Explore the planets, houses (traditional life areas), and dashas (planetary periods), with explanations in everyday language.', points: ['Readable chapters, from the essentials to advanced methods', 'North Indian and South Indian chart styles', 'Room to explore at your own pace'], image: 'astrodyuti-store-04.webp', alt: 'AstroDyuti birth chart with birth details and a North Indian chart diagram', caption: 'Your kundli, with context.' },
  { id: 'day', label: 'Daily readings', eyebrow: 'Make a daily connection', title: 'A fresh way to look at your day.', description: 'Start with a personal reading drawn from your birth chart and transits, the planets’ current positions. Explore your week or month when you want a wider view.', points: ['A personal daily reading, free to open', 'Weekly and monthly perspectives', 'Five-year forecasts for longer life themes'], image: 'astrodyuti-store-01.webp', alt: 'AstroDyuti home with personal reading tabs and current-hour guidance', caption: 'Your chart, brought into the present.' },
  { id: 'timing', label: 'Timing', eyebrow: 'Follow your local day', title: 'The day’s timing, wherever you are.', description: 'Check the panchang, the daily Vedic almanac, for your city. Follow festivals, explore the current hour, or search for a muhurta—an auspicious time window for a planned activity.', points: ['City and timezone-specific panchang', 'This Hour for a quick timing overview', 'Muhurta searches for the weeks ahead'], image: 'astrodyuti-store-08.webp', alt: 'The AstroDyuti Panchanga screen displaying a local almanac and timing windows', caption: 'Local timing, at a glance.' },
  { id: 'match', label: 'Compatibility', eyebrow: 'Explore your connections', title: 'More to a match than a number.', description: 'Compare two birth charts through the traditional 36-point matching system. Read about the strengths and possible points of friction, with explanations you can talk through together.', points: ['Classical Ashtakuta or Guna Milan matching', 'Clear explanations alongside the score', 'A perspective for conversation and reflection'], image: 'astrodyuti-store-06.webp', alt: 'AstroDyuti Match showing the birth-profile selection and detail-entry flow', caption: 'Begin with two birth profiles.' },
];
---
<section id="inside" class="section tour-section" aria-labelledby="tour-title">
  <div class="container">
    <div class="section-heading split"><div><p class="eyebrow">An everyday companion</p><h2 id="tour-title">A deeper chart.<br />A clearer picture.</h2></div><p>New to Vedic astrology or returning to a familiar tradition? Start with what matters to you. There’s room to go deeper.</p></div>
    <div class="product-tour" data-product-tour>
      <div class="tour-tabs" role="tablist" aria-label="Explore app features" hidden>{panels.map((panel, index) => <button id={`tab-${panel.id}`} role="tab" aria-controls={`panel-${panel.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-tab={panel.id}>{panel.label}</button>)}</div>
      {panels.map((panel, index) => <div class="tour-panel" id={`panel-${panel.id}`} role="tabpanel" aria-labelledby={`tab-${panel.id}`} data-panel={panel.id}>
        <div class="tour-copy"><span class="tour-number" aria-hidden="true">0{index + 1}</span><p class="eyebrow">{panel.eyebrow}</p><h3>{panel.title}</h3><p class="tour-description">{panel.description}</p><ul>{panel.points.map((point) => <li><Icon name="check" size={16} />{point}</li>)}</ul><a class="text-link" href="/get.html">Explore in the app<Icon size={16} /></a></div>
        <figure class="tour-image"><img src={`/assets/screens/${panel.image}`} alt={panel.alt} width="660" height="1434" loading="lazy" /><figcaption>{panel.caption}</figcaption></figure>
      </div>)}
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-product-tour]').forEach((tour) => {
    const tabs = Array.from(tour.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(tour.querySelectorAll<HTMLElement>('[data-panel]'));
    function activate(index: number, focus = false) {
      tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
      panels.forEach((panel, i) => { panel.hidden = i !== index; });
      if (focus) tabs[index].focus();
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : event.key === 'ArrowLeft' ? (index - 1 + tabs.length) % tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : undefined;
        if (next !== undefined) { event.preventDefault(); activate(next, true); }
      });
    });
    activate(0);
    const list = tour.querySelector<HTMLElement>('[role="tablist"]');
    if (list) list.hidden = false;
  });
</script>
<style>
  .tour-section { border-top: 1px solid var(--line); }
  .tour-tabs { display: flex; gap: 30px; overflow-x: auto; border-bottom: 1px solid var(--line); scrollbar-width: thin; margin-bottom: 30px; }
  .tour-tabs button { flex-shrink: 0; padding: 14px 1px 17px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--muted); font-size: 14px; font-weight: 500; }
  .tour-tabs button[aria-selected='true'] { color: var(--ink); border-color: var(--green); }
  .tour-tabs button:focus-visible { outline-offset: -4px; }
  .tour-panel { display: grid; grid-template-columns: 1.15fr .85fr; min-height: 530px; overflow: hidden; border-radius: var(--radius); background: var(--sand); }
  .tour-panel + .tour-panel:not([hidden]) { margin-top: 20px; }
  .tour-copy { position: relative; padding: 54px 0 54px 58px; max-width: 525px; }
  .tour-number { position: absolute; right: 0; top: 40px; color: #827862; font-family: var(--display); font-size: 75px; line-height: 1; }
  .tour-copy .eyebrow { position: relative; margin-bottom: 24px; padding-right: 65px; font-size: 20px; }
  .tour-copy h3 { position: relative; max-width: 390px; font-size: 43px; }
  .tour-description { margin-top: 20px; color: #626255; font-size: 15px; line-height: 1.95; }
  .tour-copy ul { display: grid; gap: 10px; margin: 22px 0; padding: 0; list-style: none; }
  .tour-copy li { display: flex; align-items: baseline; gap: 10px; color: #50594c; font-size: 13px; }
  .tour-copy li svg { flex-shrink: 0; align-self: center; color: var(--green); }
  .tour-copy .text-link { font-size: 13px; }
  .tour-image { align-self: center; justify-self: center; padding: 28px 30px; text-align: center; }
  .tour-image img { display: block; width: 205px; max-height: 450px; object-fit: contain; border-radius: 17px; box-shadow: 0 16px 32px -20px #3a3b324d; }
  .tour-image figcaption { margin-top: 16px; color: var(--muted); font-size: 11px; }
  @media (max-width: 1000px) { .tour-copy { padding: 38px 0 38px 34px; } .tour-copy h3 { font-size: 36px; } .tour-number { right: 10px; top: 20px; } }
  @media (max-width: 760px) { .tour-tabs { gap: 24px; margin-bottom: 22px; } .tour-tabs button { font-size: 13px; } .tour-panel { grid-template-columns: 1fr; min-height: 0; } .tour-copy { padding: 32px 26px 8px; max-width: none; } .tour-copy h3 { font-size: 34px; max-width: 350px; } .tour-number { right: 22px; top: 24px; font-size: 46px; } .tour-copy .eyebrow { margin-bottom: 20px; padding-right: 46px; font-size: 18px; } .tour-copy li { font-size: 12px; } .tour-image { padding: 24px 24px 30px; } .tour-image img { width: 183px; } }
</style>
