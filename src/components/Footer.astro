---
import { footerGroups, site } from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/"><img src="/assets/brand-icon.webp" width="38" height="38" alt="" /><span>AstroDyuti</span></a>
      <p>Vedic wisdom.<br />An everyday companion.</p>
      <a class="contact-link" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    {footerGroups.map((group) => <nav aria-label={group.title}><h2 class="footer-heading">{group.title}</h2><ul>{group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul></nav>)}
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getUTCFullYear()} {site.company} · Sunnyvale, California</span>
    <span>For reflection. Your choices remain yours.</span>
  </div>
</footer>
