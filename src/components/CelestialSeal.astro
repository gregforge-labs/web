---
interface Props { motif?: 'compass' | 'orrery' | 'sun' | 'shield'; size?: number; class?: string }
const { motif = 'compass', size = 56, class: className } = Astro.props;
const ticks = Array.from({ length: 24 }, (_, i) => ({ rotation: i * 15, major: i % 3 === 0 }));
---
<svg class:list={['celestial-seal', className]} data-seal={motif} width={size} height={size} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <circle cx="32" cy="32" r="30" fill="currentColor" fill-opacity=".035" stroke-opacity=".24" stroke-width=".7" />
  <circle cx="32" cy="32" r="26.5" stroke-opacity=".55" stroke-width=".55" />
  {ticks.map((tick) => <path d={tick.major ? 'M32 3.5v2.7' : 'M32 4.2v1.1'} transform={`rotate(${tick.rotation} 32 32)`} stroke-opacity={tick.major ? '.65' : '.35'} stroke-width=".65" />)}
  {motif === 'compass' && <>
    <circle cx="32" cy="32" r="17.5" stroke-opacity=".45" stroke-width=".6" />
    <path d="m18 18 14 8 14-8-8 14 8 14-14-8-14 8 8-14Z" fill="currentColor" fill-opacity=".06" stroke-opacity=".55" stroke-width=".65" />
    <path d="m32 10 4.5 17.5L54 32l-17.5 4.5L32 54l-4.5-17.5L10 32l17.5-4.5Z" fill="var(--surface, #fffdf8)" stroke-width=".9" />
    <path d="M32 10v22l4.5-4.5ZM54 32H32l4.5 4.5ZM32 54V32l-4.5 4.5ZM10 32h22l-4.5-4.5Z" fill="currentColor" fill-opacity=".19" stroke="none" />
    <circle cx="32" cy="32" r="3.5" fill="currentColor" stroke="none" /><circle cx="32" cy="32" r="1.3" fill="var(--surface, #fffdf8)" stroke="none" />
  </>}
  {motif === 'orrery' && <>
    <circle cx="32" cy="32" r="16.5" stroke-width=".7" stroke-opacity=".6" />
    <ellipse cx="32" cy="32" rx="22" ry="9" transform="rotate(-36 32 32)" stroke-width=".9" />
    <ellipse cx="32" cy="32" rx="9" ry="22" transform="rotate(-36 32 32)" stroke-width=".6" stroke-opacity=".45" />
    <circle cx="32" cy="32" r="5.5" fill="currentColor" fill-opacity=".15" stroke-width=".9" /><circle cx="32" cy="32" r="2" fill="currentColor" stroke="none" />
    <circle cx="48" cy="19" r="2.5" fill="var(--surface, #fffdf8)" stroke-width=".9" /><circle cx="18.4" cy="41.3" r="1.7" fill="currentColor" stroke="none" />
  </>}
  {motif === 'sun' && <>
    {Array.from({ length: 16 }, (_, i) => <path d={i % 2 === 0 ? 'M32 11v6' : 'M32 13v3'} transform={`rotate(${i * 22.5} 32 32)`} stroke-width={i % 2 === 0 ? '.95' : '.65'} stroke-opacity={i % 2 === 0 ? '.9' : '.55'} />)}
    <circle cx="32" cy="32" r="11.5" fill="currentColor" fill-opacity=".07" stroke-width=".85" /><circle cx="32" cy="32" r="8" stroke-width=".55" stroke-opacity=".5" />
    <path d="M32 24a8 8 0 0 1 0 16Z" fill="currentColor" fill-opacity=".14" stroke="none" /><circle cx="32" cy="32" r="1.8" fill="currentColor" stroke="none" />
  </>}
  {motif === 'shield' && <>
    <path d="M32 12c5 4.5 10 6 16 7.5v13C48 43 39 49 32 52c-7-3-16-9-16-19.5v-13C22 18 27 16.5 32 12Z" fill="currentColor" fill-opacity=".05" stroke-width=".9" />
    <path d="M32 17c3.8 3 7.7 4.4 12 5.6v9.9c0 8.2-6.8 13.3-12 15.8-5.2-2.5-12-7.6-12-15.8v-9.9C24.3 21.4 28.2 20 32 17Z" stroke-opacity=".45" stroke-width=".55" />
    <rect x="26" y="29" width="12" height="11" rx="2" fill="var(--surface, #fffdf8)" stroke-width=".85" /><path d="M28.5 29v-3.5a3.5 3.5 0 0 1 7 0V29" stroke-width=".9" /><circle cx="32" cy="34" r="1.2" fill="currentColor" stroke="none" /><path d="M32 35v1.8" stroke-width=".9" />
  </>}
</svg>
