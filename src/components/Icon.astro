---
interface Props { name?: 'arrow' | 'check' | 'sun' | 'chart' | 'spark' | 'globe' | 'menu' | 'mail' | 'orbit' | 'moon'; size?: number; class?: string }
const { name = 'arrow', size = 20, class: className } = Astro.props;
---
<svg class:list={['icon', className]} data-icon={name} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={size >= 28 ? 1.1 : 1.4} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M4 12h15m-5-5 5 5-5 5" />}
  {name === 'check' && <><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity=".045" stroke-opacity=".3" stroke-width="1" /><path d="m8 12 2.5 2.5 5.5-6" /></>}
  {name === 'chart' && <><rect x="3" y="3" width="18" height="18" rx="1.5" stroke-opacity=".65" /><path d="m12 3 9 9-9 9-9-9Z" fill="currentColor" fill-opacity=".055" /><path d="M3 3l6 6m6 6 6 6M21 3l-6 6m-6 6-6 6" stroke-opacity=".4" stroke-width="1" /><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" /></>}
  {name === 'spark' && <><path d="M12 2.5 14 10l7.5 2-7.5 2-2 7.5L10 14l-7.5-2 7.5-2Z" fill="currentColor" fill-opacity=".08" stroke-width="1.05" /><path d="m6 6 2 2m8 8 2 2M18 6l-2 2M8 16l-2 2" stroke-opacity=".55" stroke-width="1" /><circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none" /></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="5" fill="currentColor" fill-opacity=".075" /><circle cx="12" cy="12" r="2.5" stroke-opacity=".4" stroke-width=".8" />{Array.from({ length: 12 }, (_, i) => <path d={i % 2 === 0 ? 'M12 2v2' : 'M12 2.7v1'} transform={`rotate(${i * 30} 12 12)`} stroke-width="1" />)}</>}
  {name === 'globe' && <><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity=".045" /><ellipse cx="12" cy="12" rx="4.1" ry="9" stroke-width="1" /><path d="M3.3 12h17.4M5 6.6c4.3 2 9.7 2 14 0M5 17.4c4.3-2 9.7-2 14 0" stroke-width=".8" stroke-opacity=".55" /></>}
  {name === 'menu' && <><path d="M4 7h16M4 17h16" /><path d="M4 12h12" stroke-opacity=".65" /></>}
  {name === 'mail' && <><rect x="2.5" y="5" width="19" height="14" rx="2.2" fill="currentColor" fill-opacity=".045" /><path d="m3.2 6 7.5 6a2 2 0 0 0 2.6 0l7.5-6" /><path d="m3.5 18 5.7-5m11.3 5-5.7-5" stroke-opacity=".45" stroke-width=".8" /></>}
  {name === 'orbit' && <><circle cx="12" cy="12" r="3.1" fill="currentColor" fill-opacity=".15" stroke-width="1" /><ellipse cx="12" cy="12" rx="10" ry="5.5" transform="rotate(-35 12 12)" stroke-width="1" /><path d="M9.5 3.1a9.3 9.3 0 0 1 11 10.5M14.5 20.9A9.3 9.3 0 0 1 3.5 10.4" stroke-opacity=".45" stroke-width=".8" /><circle cx="18.8" cy="5.8" r="1.35" fill="currentColor" stroke="none" /></>}
  {name === 'moon' && <><path d="M16.6 3.8A8.8 8.8 0 1 0 20.2 16 8 8 0 0 1 16.6 3.8Z" fill="currentColor" fill-opacity=".08" /><path d="m18.7 5.3.7 2.5 2.3.7-2.3.7-.7 2.5-.7-2.5-2.3-.7 2.3-.7Z" fill="currentColor" stroke="none" /></>}
</svg>
